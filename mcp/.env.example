# Copy to mcp/.env (git-ignored). Used when the server is started without env vars,
# e.g. by `claude mcp add`. Claude Desktop can pass the same values in its config instead.

# Local Supabase: values printed by `npm run db:start`
RECAPWELL_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key only — the server acts as a normal user, so RLS applies.
RECAPWELL_SUPABASE_KEY=sb_publishable_xxx

# The Recapwell user Claude acts as (demo users have password `password123`)
RECAPWELL_EMAIL=alice@recapwell.test
RECAPWELL_PASSWORD=password123
