{
  "name": "@recapwell/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for Recapwell: lets Claude read your workspaces, recaps and action items (stdio, local).",
  "type": "module",
  "bin": {
    "recapwell-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/supabase-js": "^2.119.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.25.0",
    "vitest": "^3.2.0"
  }
}
