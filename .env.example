# Local: values printed by `npm run db:start`. Cloud: Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_...) or the legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Used to build auth redirect URLs (email confirmation, Google OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secrets (never NEXT_PUBLIC_)
# Local: "Secret" key printed by `npm run db:start`
SUPABASE_SECRET_KEY=sb_secret_xxx
# Stripe sandbox: Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_xxx
# Printed by `npm run stripe:listen` (local) or the webhook endpoint page (deployed)
STRIPE_WEBHOOK_SECRET=whsec_xxx
